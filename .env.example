# ---- Mercado ----
SYMBOL=BTCUSDT
CAPITAL_USD=10
FEE_BPS=10            # 10 = 0.10% taker spot. Con BNB: 7.5
SLIP_BPS=1            # slippage adicional asumido por lado
SAFETY_MARGIN=1.5     # exige edge > breakeven * margen
MAX_SPREAD_BPS=2
MIN_DEPTH_USD=20000   # liquidez minima top-5 por lado
EDGE_K=0.5            # coeficiente del estimador de edge (CALIBRAR con la matriz)

# ---- Simulacion / riesgo ----
SIM_LATENCY_MS=200
TRIGGER_COOLDOWN_S=45
TIME_STOP_S=120
RISK_PCT=0.02
MAX_DAILY_LOSS_USD=0.5
DEMO_MODE=0           # 1 = ignora el filtro de rentabilidad para probar el cableado

# ---- Gemini (opcional) ----
USE_GEMINI=0
GEMINI_MODEL=gemini-2.5-flash
GEMINI_KEYS=          # llaves separadas por coma
GEMINI_MAX_PER_HOUR=60

# ---- Testnet (solo cableado, ver exchange.py) ----
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

DB_PATH=mxl.db

# ---- Despliegue (Railway) ----
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=pon-una-clave-larga      # obligatorio si HOST != 127.0.0.1
# DB_PATH=/data/mxl.db                         # ruta del Volume para que no se pierdan los datos
